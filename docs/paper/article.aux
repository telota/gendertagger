\def\@LN@column{1}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-method performance on the GND benchmark subset ($N = 2{,}253$; $2{,}048$ male, $205$ female). \emph  {Answered} counts entries on which the method committed to \texttt  {male} or \texttt  {female} (the complement are abstentions or ambiguous outputs); \emph  {Correct \%} is the share of correct labels among answered entries; \emph  {Effective accuracy} divides correct labels by the full benchmark size, so abstentions count against the method. Per-class recall is correct predictions divided by the GND class size and is reported with Wilson 95\% confidence intervals; the female-class intervals are wide ($n=205$) and should temper any per-method ranking.}}{13}{table.3}\protected@file@percent }
\newlabel{tab:gnd-benchmark}{{3}{13}{Per-method performance on the GND benchmark subset ($N = 2{,}253$; $2{,}048$ male, $205$ female). \emph {Answered} counts entries on which the method committed to \texttt {male} or \texttt {female} (the complement are abstentions or ambiguous outputs); \emph {Correct \%} is the share of correct labels among answered entries; \emph {Effective accuracy} divides correct labels by the full benchmark size, so abstentions count against the method. Per-class recall is correct predictions divided by the GND class size and is reported with Wilson 95\% confidence intervals; the female-class intervals are wide ($n=205$) and should temper any per-method ranking}{table.3}{}}
