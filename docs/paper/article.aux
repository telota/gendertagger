\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-record agreement tiers, segmented by the majority label assigned by the bank. The yellow \texttt  {unanimous} band dominates the \texttt  {male} column; the \texttt  {female} column is more evenly split across tiers; and \texttt  {ambiguous} entries cluster in the lower (less-agreed) tiers. The $P_i$ and $H_i$ distributions underlying these tiers are shown in Figure~\ref {fig:agreement-distributions}.}}{15}{figure.2}\protected@file@percent }
\newlabel{fig:agreement-tiers}{{2}{15}{Per-record agreement tiers, segmented by the majority label assigned by the bank. The yellow \texttt {unanimous} band dominates the \texttt {male} column; the \texttt {female} column is more evenly split across tiers; and \texttt {ambiguous} entries cluster in the lower (less-agreed) tiers. The $P_i$ and $H_i$ distributions underlying these tiers are shown in Figure~\ref {fig:agreement-distributions}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Distributions of Fleiss' per-item agreement $P_i$ (left) and Shannon entropy $H_i$ (right) across the $8{,}277$ register entries. Both distributions are strongly bimodal: most entries are close to unanimity ($P_i \to 1$, $H_i \to 0$), with a long thin tail of contested entries that drives the editorial review queue.}}{16}{figure.3}\protected@file@percent }
\newlabel{fig:agreement-distributions}{{3}{16}{Distributions of Fleiss' per-item agreement $P_i$ (left) and Shannon entropy $H_i$ (right) across the $8{,}277$ register entries. Both distributions are strongly bimodal: most entries are close to unanimity ($P_i \to 1$, $H_i \to 0$), with a long thin tail of contested entries that drives the editorial review queue}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-method effective accuracy and per-class recall on the Schleiermacher GND benchmark subset ($N = 2{,}253$ persons; $2{,}048$ male, $205$ female). Effective accuracy counts abstentions as errors, which is why the transformer classifiers --- despite high precision when they do answer --- score below the dictionary methods. The female-recall column shows the largest spread between methods.}}{16}{figure.4}\protected@file@percent }
\newlabel{fig:benchmark-recall}{{4}{16}{Per-method effective accuracy and per-class recall on the Schleiermacher GND benchmark subset ($N = 2{,}253$ persons; $2{,}048$ male, $205$ female). Effective accuracy counts abstentions as errors, which is why the transformer classifiers --- despite high precision when they do answer --- score below the dictionary methods. The female-recall column shows the largest spread between methods}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gender coverage of the Schleiermacher person register ($N = 8{,}277$) before and after multi-method aggregation. \emph  {Left}: GND-only baseline --- $72.8\%$ of entries have no resolvable authority record. \emph  {Right}: combined output of the aggregation pipeline (\S  \ref {sec:aggregation}); every entry receives a label, with the residual \texttt  {unknown} category restricted to entries on which the methods either abstained or could not reach consensus.}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:gender-pies}{{5}{17}{Gender coverage of the Schleiermacher person register ($N = 8{,}277$) before and after multi-method aggregation. \emph {Left}: GND-only baseline --- $72.8\%$ of entries have no resolvable authority record. \emph {Right}: combined output of the aggregation pipeline (\S \ref {sec:aggregation}); every entry receives a label, with the residual \texttt {unknown} category restricted to entries on which the methods either abstained or could not reach consensus}{figure.5}{}}
