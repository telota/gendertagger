{
  "name": "gendertagger-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 browser client for the gendertagger /api/v1 service.",
  "engines": {
    "node": "^26.9.0"
  },
  "scripts": {
    "smoke:production": "node scripts/production-smoke.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.test.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "i18n:check": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm run i18n:check && npm run api:check && npm test"
  },
  "dependencies": {
    "@headlessui/vue": "1.7.23",
    "@phosphor-icons/vue": "2.2.1",
    "@tanstack/vue-query": "5.103.2",
    "openapi-fetch": "0.17.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.12",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/language-server": "3.3.11",
    "@vue/test-utils": "2.5.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "jsonc-eslint-parser": "3.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "typescript-language-server": "6.0.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
