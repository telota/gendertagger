root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.{json,jsonc,toml,yaml,yml}]
indent_size = 2

[*.{css,html,js,jsx,mjs,cjs,mts,scss,ts,tsx,vue,xml}]
indent_size = 2

[Makefile]
indent_style = tab
