# Copy this file to .env before following QUICKSTART.md.
POSTGRES_USER=postgres
# For a server, replace this with a random URL-safe password before creating the database.
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gendertagger
LOG_LEVEL=INFO
# Build the backend and frontend images locally; no private registry is required.
REGISTRY_PREFIX=gendertagger-
TAG=local
# For CI-published images instead, see docs/21-production-promotion.md:
# REGISTRY_PREFIX=<CI_REGISTRY_IMAGE from the selected pipeline, with a trailing slash>
# TAG=<full commit SHA from that successful default-branch pipeline, not main>
# Required run provenance: fill these with the built checkout's Git commit and uv.lock SHA-256.
# QUICKSTART.md gives the commands; update both for the checkout matching the deployed images.
GENDERTAGGER_CODE_GIT_COMMIT=
GENDERTAGGER_DEPENDENCY_LOCK_SHA256=
# Optional operator reference. Supply this URL as local_llm.config.base_url when creating a run.
# LLM_BASE_URL=http://your-institutional-server:11434/v1
# Optional production bind mounts instead of named volumes; the API and workers must share artifacts.
# POSTGRES_DATA_PATH=/mnt/data/postgres
# REDIS_DATA_PATH=/mnt/data/redis
# ARTIFACTS_PATH=/mnt/data/artifacts
