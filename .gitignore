# Repository-wide ignore rules. Each application ignores its own build and test output in its own file
# (backend/.gitignore, frontend/.gitignore); the rules here apply everywhere in the repository.

# Secrets and local configuration
.env
.env.*
!.env.example

# Dependency trees and virtual environments, wherever a tool creates them
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]

# Tool caches; they appear at the repository root too when a tool runs from there
.mypy_cache/
.pytest_cache/
.ruff_cache/
.import_linter_cache/
.hypothesis/
.ipynb_checkpoints/

# Logs, including LaTeX build logs under docs/paper/
*.log

# Editor, operating-system, and coding-agent state
.vscode/
.idea/
.DS_Store
.trunk/
.claude/
.codex/
.agents/

# Research material, private data, and model weights, which never enter Git
data/raw/
/private/
__scrap/
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.bin
*.safetensors
